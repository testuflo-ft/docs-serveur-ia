+// ---------------------------------------------------------------------------
+// Scenario 5b — purgeFolder: null or empty name throws 400
+// ---------------------------------------------------------------------------
+describe("Scenario 5b — purgeFolder: null/empty name rejected with 400", () => {
+  const DOCS_PATH = "/storage/documents";
+  const fsMock = {
+    readdirSync: jest.fn(() => []),
+    lstatSync: jest.fn(() => ({ isDirectory: () => true, isSymbolicLink: () => false })),
+    existsSync: jest.fn(() => false),
+    unlinkSync: jest.fn(),
+    rmdirSync: jest.fn(),
+  };
+  const stubs = {
+    ".": {
+      purgeVectorCache: jest.fn(),
+      purgeSourceDocument: jest.fn(),
+      normalizePath: (p) => p,
+      isWithin: () => true,
+      documentsPath: DOCS_PATH,
+    },
+    "../../models/documents": {
+      Document: { removeDocuments: jest.fn() },
+    },
+    "../../utils/prisma": mockPrisma,
+    fs: fsMock,
+  };
+
+  test("purgeFolder(null) throws FOLDER_NAME_REQUIRED", async () => {
+    const { purgeFolder } = loadCandidateModule(CANDIDATE_PURGE, stubs);
+    await expect(purgeFolder(null)).rejects.toMatchObject({
+      statusCode: 400,
+      code: "FOLDER_NAME_REQUIRED",
+    });
+  });
+
+  test("purgeFolder('') throws FOLDER_NAME_REQUIRED", async () => {
+    const { purgeFolder } = loadCandidateModule(CANDIDATE_PURGE, stubs);
+    await expect(purgeFolder("")).rejects.toMatchObject({
+      statusCode: 400,
+      code: "FOLDER_NAME_REQUIRED",
+    });
+  });
+
+  test("purgeFolder('   ') (whitespace only) throws FOLDER_NAME_REQUIRED", async () => {
+    const { purgeFolder } = loadCandidateModule(CANDIDATE_PURGE, stubs);
+    await expect(purgeFolder("   ")).rejects.toMatchObject({
+      statusCode: 400,
+      code: "FOLDER_NAME_REQUIRED",
+    });
+  });
+});
+
+// ---------------------------------------------------------------------------
+// Scenario 5c — purgeFolder: non-existent folder throws 404
+// ---------------------------------------------------------------------------
+describe("Scenario 5c — purgeFolder: non-existent folder throws 404 FOLDER_NOT_FOUND", () => {
+  test("purgeFolder with a valid name but missing directory throws 404", async () => {
+    const DOCS_PATH = "/storage/documents";
+    const TARGET = "does-not-exist";
+
+    const fsMock = {
+      readdirSync: jest.fn((p) => {
+        if (p === DOCS_PATH) return [TARGET];
+        return [];
+      }),
+      lstatSync: jest.fn(() => ({ isDirectory: () => true, isSymbolicLink: () => false })),
+      existsSync: jest.fn(() => false), // ← folder missing
+      unlinkSync: jest.fn(),
+      rmdirSync: jest.fn(),
+    };
+
+    const stubs = {
+      ".": {
+        purgeVectorCache: jest.fn(),
+        purgeSourceDocument: jest.fn(),
+        normalizePath: (p) => p,
+        isWithin: () => true,
+        documentsPath: DOCS_PATH,
+      },
+      "../../models/documents": {
+        Document: { removeDocuments: jest.fn() },
+      },
+      "../../utils/prisma": mockPrisma,
+      fs: fsMock,
+    };
+
+    const { purgeFolder } = loadCandidateModule(CANDIDATE_PURGE, stubs);
+    await expect(purgeFolder(TARGET)).rejects.toMatchObject({
+      statusCode: 404,
+      code: "FOLDER_NOT_FOUND",
+      message: expect.stringMatching(/was not found/i),
+    });
+    expect(fsMock.unlinkSync).not.toHaveBeenCalled();
+    expect(fsMock.rmdirSync).not.toHaveBeenCalled();
+  });
+});
+
+// ---------------------------------------------------------------------------
+// Scenario 5d — purgeFolder: path traversal throws 400
+// ---------------------------------------------------------------------------
+describe("Scenario 5d — purgeFolder: path traversal throws 400 FOLDER_OUTSIDE_DOCUMENTS", () => {
+  test("purgeFolder with a traversal path throws FOLDER_OUTSIDE_DOCUMENTS", async () => {
+    const DOCS_PATH = "/storage/documents";
+    const TRAVERSAL = "../../../etc/passwd";
+
+    const fsMock = {
+      readdirSync: jest.fn(() => []),
+      lstatSync: jest.fn(() => ({ isDirectory: () => true, isSymbolicLink: () => false })),
+      existsSync: jest.fn(() => true),
+      unlinkSync: jest.fn(),
+      rmdirSync: jest.fn(),
+    };
+
+    const stubs = {
+      ".": {
+        purgeVectorCache: jest.fn(),
+        purgeSourceDocument: jest.fn(),
+        normalizePath: (p) => p, // normalizePath passes through for this test
+        isWithin: (base, target) => target.startsWith(base), // real logic
+        documentsPath: DOCS_PATH,
+      },
+      "../../models/documents": {
+        Document: { removeDocuments: jest.fn() },
+      },
+      "../../utils/prisma": mockPrisma,
+      fs: fsMock,
+    };
+
+    const { purgeFolder } = loadCandidateModule(CANDIDATE_PURGE, stubs);
+    await expect(purgeFolder(TRAVERSAL)).rejects.toMatchObject({
+      statusCode: 400,
+      code: "FOLDER_OUTSIDE_DOCUMENTS",
+      message: expect.stringMatching(/outside the documents/i),
+    });
+    expect(fsMock.unlinkSync).not.toHaveBeenCalled();
+    expect(fsMock.rmdirSync).not.toHaveBeenCalled();
+  });
+});

